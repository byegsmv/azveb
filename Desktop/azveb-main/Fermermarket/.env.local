# ==========================================
# 1. VERİTABANI (PostgreSQL / Prisma)
# ==========================================
# Yerel PostgreSQL veya Supabase / Neon bağlantı adresi
DATABASE_URL="postgresql://postgres:sifreniz@localhost:5432/fermermarket_db?schema=public"
# Supabase/Neon connection pooling kullanıyorsanız (Opsiyonel)
DIRECT_URL="postgresql://postgres:sifreniz@localhost:5432/fermermarket_db?schema=public"

# ==========================================
# 2. SİSTEM & UYGULAMA
# ==========================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# 3. KİMLİK DOĞRULAMA (JWT & Auth)
# ==========================================
# Rastgele ve güçlü gizli anahtarlar (ör. openssl rand -base64 32 ile üretilebilir)
JWT_SECRET="fmk_jwt_secret_key_change_this_32_chars_min"
JWT_REFRESH_SECRET="fmk_refresh_token_secret_key_change_this"
NEXTAUTH_SECRET="fmk_nextauth_secret_key_change_this"

# ==========================================
# 4. CRON & ZAMANLANMIŞ İŞLER
# ==========================================
# Otomatik ilan süresi dolumu ve arka plan görevleri için doğrulama anahtarı
CRON_SECRET="fmk_cron_secret_key_2026"

# ==========================================
# 5. YAPAY ZEKA (Google Gemini AI)
# ==========================================
# Yapay zeka aqronom, fiyat tahmini ve ilan önerisi için Google AI Studio anahtarı
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ==========================================
# 6. E-POSTA SER VİSİ (Resend / SMTP)
# ==========================================
# Bildirim ve karşılama e-postaları için
RESEND_API_KEY="re_123456789_YourResendKey"
EMAIL_FROM="FermerMarket <onboarding@resend.dev>"

# ==========================================
# 7. DOSYA YÜKLEME (Vercel Blob Storage)
# ==========================================
# Resim ve belge yüklemeleri için
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_123456789"

# ==========================================
# 8. WEB PUSH BİLDİRİMLERİ (VAPID)
# ==========================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_public_vapid_key"
VAPID_PRIVATE_KEY="your_private_vapid_key"
VAPID_SUBJECT="mailto:info@fermermarket.az"